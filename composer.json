{
    "name": "zifala/go-whatsapp-laravel",
    "description": "Laravel package for go-whatsapp-web-multidevice using Saloon",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Zifala\\GoWhatsApp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Mohamed Osman",
            "email": "mohaaosman12@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "saloonphp/saloon": "^3.0",
        "saloonphp/laravel-plugin": "^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zifala\\GoWhatsApp\\GoWhatsAppServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "crescat-io/saloon-sdk-generator": "^1.4",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
